# Langflow / server-side secrets.
# Copy to `.env` (never commit it) — docker compose reads this file automatically.

# Groq API key — free tier, used by the StudyMate agent by default.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only needed if you switch the agent to Google Gemini.
# Create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
