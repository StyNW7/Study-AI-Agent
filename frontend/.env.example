# StudyMate frontend configuration
#
# Copy this file to `.env` and fill in your flow ID:
#   cp .env.example .env
#
# Never put a model provider key (Groq / Gemini) in this file.
# Provider keys belong to Langflow only — see the project root .env.example.

# Where Langflow is running.
VITE_LANGFLOW_BASE_URL=http://localhost:7860

# The StudyMate flow ID, copied from the Langflow flow URL or its API panel.
VITE_LANGFLOW_FLOW_ID=

# Only needed if your Langflow instance requires an API key
# (not needed when LANGFLOW_AUTO_LOGIN=true, which is the local default).
VITE_LANGFLOW_API_KEY=

# Development only: serve scripted answers so the UI works without Langflow.
VITE_USE_MOCK_AI=false
